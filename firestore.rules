rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 🛡️ HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // FETCH SEKALI SAJA: Mengambil data user profil satu kali per request
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userData().get('role', '');
    }
    
    function isOwner() { return isSignedIn() && userRole() == 'OWNER'; }
    function isSuperAdmin() { return isSignedIn() && userRole() == 'SUPER_ADMIN'; }
    function isKurikulum() { return isSignedIn() && userRole() == 'KURIKULUM'; }
    function isKepsek() { return isSignedIn() && userRole() == 'KEPALA_SEKOLAH'; }
    function isGuru() { return isSignedIn() && userRole() == 'GURU'; }
    
    function isAdmin() { 
      let role = userRole();
      return isSignedIn() && (role == 'OWNER' || role == 'SUPER_ADMIN'); 
    }

    function isStaff() { 
      let role = userRole();
      return isSignedIn() && (role == 'OWNER' || role == 'SUPER_ADMIN' || role == 'KURIKULUM' || role == 'KEPALA_SEKOLAH' || role == 'GURU'); 
    }
    
    // Guru hanya bisa akses jika subjectId ada di daftar pengampu
    function managesSubject(subjectId) {
      let data = userData();
      let role = data.get('role', '');
      return role == 'OWNER' || role == 'SUPER_ADMIN' || role == 'KURIKULUM' || 
             (role == 'GURU' && subjectId in data.get('managedSubjects', []));
    }
    
    // Guru hanya bisa akses jika kelas siswa ada di daftar kelas yang diajar
    function managesClass(className) {
      let data = userData();
      let role = data.get('role', '');
      return role == 'OWNER' || role == 'SUPER_ADMIN' || role == 'KURIKULUM' || role == 'KEPALA_SEKOLAH' || 
             (role == 'GURU' && className in data.get('managedClasses', []));
    }

    // --- 📂 COLLECTION RULES ---

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.get('status', '') == 'pending';
      allow update: if 
        // Self-update safe fields
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'managedSubjects', 'managedClasses']))
        ||
        // Admin self-update (can edit managed* but not role/status)
        (isAdmin() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
        ||
        // Admin updates others (SUPER_ADMIN cannot update OWNER)
        (isAdmin() && request.auth.uid != userId && (isOwner() || resource.data.get('role', '') != 'OWNER'));
      
      allow delete: if isOwner() && request.auth.uid != userId;
    }

    // 2. AUTHORIZED USERS (WHITELIST)
    match /authorized_users/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. STUDENTS COLLECTION
    match /students/{studentId} {
      allow read: if isStaff() || 
                   (isSignedIn() && userData().get('childId', '') == studentId);
      allow write: if isAdmin();
      allow delete: if isOwner();
    }

    // 4. ASSESSMENT TEMPLATES (TP/ATP)
    match /assessment_templates/{templateId} {
      allow read: if isStaff();
      allow create: if (isKurikulum() || isGuru()) && 
                    managesSubject(request.resource.data.get('subjectId', ''));
      allow update: if (isKurikulum() || isGuru()) && 
                    managesSubject(request.resource.data.get('subjectId', '')) && 
                    request.resource.data.get('status', '') != 'deleted';
      allow delete: if isOwner();
    }

    // 5. ASSESSMENTS (GRADES)
    match /assessments/{assessmentId} {
      allow read: if isStaff() || 
                   (isSignedIn() && assessmentId.split('_')[0] == userData().get('childId', ''));
      allow create: if isGuru() && managesSubject(request.resource.data.get('subjectId', ''));
      allow update: if isGuru() && managesSubject(request.resource.data.get('subjectId', ''));
      allow delete: if isOwner();
    }

    // 6. SUBJECTS (CP/KKM)
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isKurikulum();
    }
    
    // 7. CLASSES
    match /classes/{classId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    
    // 8. ASSIGNMENTS
    match /assignments/{taskId} {
      allow read: if isSignedIn();
      allow create: if isGuru() && managesSubject(request.resource.data.get('subjectId', ''));
      allow update: if isGuru() && managesSubject(request.resource.data.get('subjectId', ''));
      allow delete: if isOwner();
    }

    // 9. SYSTEM LOGS (AUDIT TRAIL)
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin(); // Log created by admin action
      allow update, delete: if false; // Audit logs are immutable
    }
  }
}
